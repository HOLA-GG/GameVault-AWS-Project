# Render / Production / Neon
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_PROJECT_ID=tiny-glade-59826617
NEON_SSLMODE=require

# Database Connection Pooling (optimized for Neon Serverless Postgres)
# Set DB_USE_NULLPOOL to true or use a connection URL with "-pooler" to use SQLAlchemy's NullPool
# (highly recommended for Neon Connection Pooling / PgBouncer setup)
DB_USE_NULLPOOL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=280
DB_POOL_TIMEOUT=30

# Web server concurrency
WEB_CONCURRENCY=2

# App Settings
STORAGE_BACKEND=none
LOCAL_UPLOAD_DIR=
LOCAL_UPLOAD_URL_PATH=/static/uploads
SHOW_RESET_DEBUG_TOKEN=false
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600
WTF_CSRF_SSL_STRICT=true
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate limiting and pagination
RATELIMIT_STORAGE_URI=memory://
MAX_UPLOAD_MB=5
GAMES_PER_PAGE=12
ADMIN_USERS_PER_PAGE=25
ADMIN_LOGS_PER_PAGE=50
RESET_TOKEN_EXPIRY_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=90

# Cloudflare R2 / S3 Compatible Storage (set STORAGE_BACKEND=r2 to activate)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Mail
MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=GameVault <noreply@gamevault.app>
MAIL_SUPPRESS_SEND=false

# Optional bootstrap admin
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=GameVault
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# LEGACY / AWS (DynamoDB & S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=gamevault-media-files
S3_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
DYNAMODB_TABLE=GameVault
DYNAMODB_USERS_TABLE=GameVaultUsers
DYNAMODB_RESET_TABLE=GameVaultPasswordReset
DYNAMODB_AUDIT_TABLE=GameVaultAuditLogs
DYNAMODB_RESET_TOKEN_INDEX=reset-token-index
DYNAMODB_AUDIT_TIMESTAMP_INDEX=scope-timestamp-index
